# =================================================================
# VARIABLES DE ENTORNO - GESTIÓN INTEGRAL PARA TALLERES (SAAS)
# Copia este archivo como .env o exporta estas variables en tu entorno
# =================================================================

# Configuración de Base de Datos MySQL
DB_URL=jdbc:mysql://localhost:3306/taller_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Configuración de Servidor de Correos (SMTP / Gmail)
# Para Gmail, genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_clave_de_aplicacion_gmail

# Configuración de Seguridad JWT
JWT_SECRET=TuTallerSaaS!ClaveSuperSeguraYSecretaParaFirmarTokens2026
JWT_EXPIRATION=36000000

# Integración con MercadoPago (Opcional para cobro de suscripciones)
# MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
