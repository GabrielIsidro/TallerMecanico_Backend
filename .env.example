# ========================================================
# VARIABLES DE ENTORNO - PATITOFIX BACKEND (Spring Boot)
# ========================================================
# Copia este archivo como '.env' en la raíz de TallerMecanico_Backend:
# cp .env.example .env
# Y completa los valores con tus credenciales de Mercado Pago y Base de Datos.

# --------------------------------------------------------
# 1. BASE DE DATOS (MySQL)
# --------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/taller_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# --------------------------------------------------------
# 2. SEGURIDAD JWT
# --------------------------------------------------------
JWT_SECRET=TuTallerSaaS!ClaveSuperSeguraYSecretaParaFirmarTokens2026
JWT_EXPIRATION=36000000

# --------------------------------------------------------
# 3. MERCADO PAGO (Checkout Pro & Webhooks)
# --------------------------------------------------------
# Obten tus credenciales en el panel de Mercado Pago Developers:
# https://www.mercadopago.com.ar/developers/panel/app
# Para pruebas locales usa credenciales de Prueba (TEST-...)
# Para cobrar dinero real usa credenciales de Producción (APP_USR-...)

# Token de acceso privado de Mercado Pago (Obligatorio para pagos reales)
MP_ACCESS_TOKEN=

# Clave secreta para verificar la firma HMAC-SHA256 del webhook
MP_WEBHOOK_SECRET=

# URL pública donde Mercado Pago enviará los avisos de pago al webhook
# Ej. Producción: https://tu-dominio.com/api/v1/backoffice/suscripciones/webhook
# Ej. Pruebas locales (ngrok): https://xxxx.ngrok-free.app/api/v1/backoffice/suscripciones/webhook
MP_NOTIFICATION_URL=

# --------------------------------------------------------
# 4. URLs DE LA APLICACIÓN
# --------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------
# 5. SERVIDOR DE CORREOS (Gmail / SMTP)
# --------------------------------------------------------
MAIL_USERNAME=gabrielisidro8@gmail.com
MAIL_PASSWORD=gpfodtmkljreylud
